<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>MegaInstaller</AssemblyName>
    <RootNamespace>MegaInstaller.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Resources\app.ico</ApplicationIcon>
    <InvariantGlobalization>true</InvariantGlobalization>
    <Version>16.0.0</Version>

    <!--
      Ships only the neutral (English) framework resources instead of every
      localized copy of .NET's own exception strings: ~5.7MB off the
      self-contained exe, and the app's own UI text is Spanish in source
      either way. Trimming would save far more but the SDK refuses it for
      WinForms outright (NETSDK1175), so this is the safe lever.
    -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>

    <!--
      Lets `dotnet build`/`publish` target net8.0-windows (WinForms) from a
      non-Windows SDK. Only affects compiling here; the app still requires
      Windows to run. See https://aka.ms/dotnet/enablewindowstargeting
    -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <!--
    Only applied when a RuntimeIdentifier is given, i.e. `dotnet publish
    -r win-x64`; a plain `dotnet build` (no RID) is unaffected. Setting
    SelfContained unconditionally breaks a plain build on non-Windows
    hosts, since it would then look for a WindowsForms runtime pack for
    the host's own RID (e.g. linux-x64), which does not exist. Compression
    shrinks the bundled single-file exe from ~155MB to ~70MB.
  -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' != ''">
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../MegaInstaller.Core/MegaInstaller.Core.csproj" />
  </ItemGroup>

  <!-- Bundled instance icons (Bootstrap Icons, MIT - see Resources/InstanceIcons/THIRD-PARTY-NOTICES.md). -->
  <ItemGroup>
    <EmbeddedResource Include="Resources\InstanceIcons\*.png">
      <LogicalName>InstanceIcons.%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
    <None Remove="Resources\InstanceIcons\THIRD-PARTY-NOTICES.md" />
    <Content Include="Resources\InstanceIcons\THIRD-PARTY-NOTICES.md">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
